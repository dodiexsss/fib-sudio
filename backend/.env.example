# Copia este archivo como .env y completa los valores.
# .env NO se sube al repositorio (está en .gitignore).

# Cadena de conexión de MongoDB.
# Atlas:  mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/fibstudio?retryWrites=true&w=majority
MONGODB_URI=

# Puerto del servidor Express.
PORT=3000

# Token para entrar al panel /admin y a las rutas de administración.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Dominios autorizados a llamar la API desde otro origen.
# Separa varios con comas. El frontend de Vite corre en http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# =========================================================
# Correo automático de bienvenida
# =========================================================
# Al enviar el formulario, la persona recibe un correo con la información
# del estudio y el botón de asesoría por WhatsApp.
# Si no configuras nada aquí, el formulario sigue funcionando, pero no envía correo.

# --- Opción A: Resend (HTTPS, recomendado en Render/Railway) ---
# Crea una API key en https://resend.com/api-keys
# Para enviar a cualquier destinatario necesitas verificar tu dominio en Resend.
# Para pruebas puedes usar: EMAIL_FROM=FibStudio <onboarding@resend.dev>
RESEND_API_KEY=

# --- Opción B: SMTP con nodemailer ---
# Gmail: SMTP_HOST=smtp.gmail.com · SMTP_PORT=587 · SMTP_SECURE=false
# (o SMTP_PORT=465 con SMTP_SECURE=true) y una contraseña de aplicación.
# Brevo: SMTP_HOST=smtp-relay.brevo.com · SMTP_PORT=587 · SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente que verá la persona. Si lo dejas vacío se usa SMTP_USER.
EMAIL_FROM=FibStudio <fibstudio.of@gmail.com>
# A dónde llegan las respuestas de la persona (tu buzón real).
EMAIL_REPLY_TO=fibstudio.of@gmail.com
# Correo que aparece en el pie del mensaje.
STUDIO_EMAIL=fibstudio.of@gmail.com

# =========================================================
# Enlaces del correo y del sitio
# =========================================================
# Número de WhatsApp con código de país, sin + ni espacios.
WHATSAPP_NUMBER=593962377437
# Mensaje que se abre en WhatsApp. {nombre} se reemplaza por el nombre de la persona.
WHATSAPP_MENSAJE=Hola FibStudio, soy {nombre}. Acabo de enviar el formulario y quiero agendar mi asesoría personalizada.

# URL pública del sitio (ej. https://fibstudio.com). Si está vacía, el correo
# no muestra el enlace "Visitar el sitio".
SITE_URL=
INSTAGRAM_URL=https://www.instagram.com/fib.studio.oc
